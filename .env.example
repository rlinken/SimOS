# Database (Required)
DATABASE_URL=postgresql://user:password@host:5432/database

# Replit Auth (Optional - for Replit hosting)
REPLIT_AUTH_ENABLED=false

# Email/SMS (Optional - for sending emails/SMS)
SENDGRID_API_KEY=your_sendgrid_api_key_here
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Stripe (Optional - for payments)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# TrackMan (Optional - for golf tracking integration)
TRACKMAN_CLIENT_ID=your_trackman_client_id_here
TRACKMAN_CLIENT_SECRET=your_trackman_client_secret_here

# Object Storage (Optional - for file uploads)
GOOGLE_APPLICATION_CREDENTIALS=path/to/credentials.json

# Session Secret (Required for production)
SESSION_SECRET=your_session_secret_change_in_production

# Instructions:
# 1. Copy this file to .env
# 2. Replace placeholder values with your actual credentials
# 3. Never commit the .env file (it's in .gitignore)
